  <link name="tray">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://iiwa_description/meshes/visual/planar_end_eff_visual.stl" />
        </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://iiwa_description/meshes/collision/planar_end_eff_collision.stl" />
        </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1" />
          <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.1" />
    </inertial>
  </link>
   
  <gazebo reference="tray">

      <material>Gazebo/DarkGrey</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
      <kp value="1e6" />
  	  <kd value="1e3" />
  </gazebo>

    <!-- end of link list -->

    <!-- joint list -->
    <joint name="joint_a1" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="link_1" />
      <axis xyz="0 0 1" />
      <limit lower="-2.9668" upper="2.9668" effort="1000" velocity="1.4834" />
      <dynamics damping="50" friction="1"/>
    </joint>
    <joint name="joint_a2" type="revolute">
      <origin xyz="-0.00043624 0 0.36" rpy="0 0 0" />
