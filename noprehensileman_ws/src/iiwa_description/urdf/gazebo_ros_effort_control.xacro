<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  

  <xacro:arg name="q0_file" default="$(find iiwa_description)/config/initial_configuration.yaml" />
  <xacro:property name="q0_file" value="$(arg q0_file)"/>
  <xacro:property name="q0" value="${xacro.load_yaml(q0_file)['id_controller_node']['ros__parameters']}"/>

  <ros2_control name="RobotSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint_a1">
      <command_interface name="effort">
        <param name="min">-2500</param>
        <param name="max">2500</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${q0['joint_a1']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_a2">
      <command_interface name="effort">
        <param name="min">-2500</param>
        <param name="max">2500</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${q0['joint_a2']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_a3">
      <command_interface name="effort">
        <param name="min">-100</param>
        <param name="max">100</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${q0['joint_a3']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_a4">
      <command_interface name="effort">
        <param name="min">-100</param>
        <param name="max">100</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${q0['joint_a4']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_a5">
      <command_interface name="effort">
        <param name="min">-100</param>
        <param name="max">100</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${q0['joint_a5']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_a6">
      <command_interface name="effort">
        <param name="min">-2500</param>
        <param name="max">2500</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${q0['joint_a6']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="joint_a7">
      <command_interface name="effort">
        <param name="min">-2500</param>
        <param name="max">2500</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${q0['joint_a7']}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

  </ros2_control>

  <!-- ros_control plugin -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find iiwa_description)/config/iiwa_effort_controllers.yaml</parameters>
    </plugin>
  </gazebo> 

</robot>
